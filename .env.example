# HTTP port for the intake API.
PORT=3001

# libsql/Turso-compatible SQLite URL. Relative paths are resolved from apps/api.
DATABASE_URL=file:./data/intake.db

# Directory for uploaded images. Relative paths are resolved from apps/api.
UPLOAD_DIR=./data/uploads

# Browser origin allowed to call the API directly (the Vite dev server proxies /api).
WEB_ORIGIN=http://localhost:5173

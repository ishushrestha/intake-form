# Listen address. Leave at 127.0.0.1 so only Caddy (or this machine) can reach the process.
HOST=127.0.0.1

# HTTP port for the intake API. In production this process also serves the web UI.
PORT=3001

# Set to production in Docker / on Azure. The API then requires a strong
# ADMIN_PASSWORD, sets Secure cookies, trusts proxy headers, and serves apps/web/dist.
# Local pnpm dev does not need this. Azure secrets go in deploy/.env instead.
# NODE_ENV=production

# libsql/Turso-compatible SQLite URL. Relative paths are resolved from apps/api.
DATABASE_URL=file:./data/intake.db

# Directory for uploaded images. Relative paths are resolved from apps/api.
UPLOAD_DIR=./data/uploads

# Optional directory of the built web app. Defaults to ../web/dist when NODE_ENV=production.
# WEB_DIST=../web/dist

# Browser origin allowed to call the API directly (the Vite dev server proxies /api).
# Comma-separated list is allowed. Local pnpm dev keeps localhost. Azure compose sets https.
WEB_ORIGIN=http://localhost:5173

# Optional extra CORS list. When set, this replaces WEB_ORIGIN for allowed origins.
# ALLOWED_ORIGINS=https://artist-lab.southindia.cloudapp.azure.com

# Shared admin password. There is no username. Change this before sharing the app.
# In production this must be at least 12 characters and must not be change-me.
ADMIN_PASSWORD=change-me

# Signs the admin session cookie. If unset, the API generates one at startup and
# existing sessions end when the process restarts.
SESSION_SECRET=replace-with-a-long-random-string

# Bearer token for the local worker's /api/worker routes. The admin cookie cannot
# call those routes. Copy the same value to apps/llm-worker/.env as INTAKE_WORKER_TOKEN.
# Leave this empty to keep the worker API closed.
WORKER_TOKEN=

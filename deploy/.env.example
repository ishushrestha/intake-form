# Public DNS name of the Azure VM. Change this and restart compose when DevOps remaps DNS.
DOMAIN=artist-lab.southindia.cloudapp.azure.com

NODE_ENV=production

# Shared Caddy tester login in front of both sites. Generate the hash with:
# docker run --rm caddy:2-alpine caddy hash-password
# Paste the full bcrypt string. Docker Compose treats $ as interpolation, so
# either wrap it in single quotes or write $$ for each $ ($$2a$$14$$...).
BASIC_AUTH_USER=tester
BASIC_AUTH_HASH=

# Intake admin desk password (no username). Must be at least 12 characters and not change-me.
ADMIN_PASSWORD=
SESSION_SECRET=

# Bearer token shared by intake (/api/worker) and the worker (INTAKE_WORKER_TOKEN).
WORKER_TOKEN=

# records-admin app login. Must not be admin/change-me. Username must not be
# "admin"; password must be at least 12 characters. Must match the records-admin
# container (ADMIN_USERNAME / ADMIN_PASSWORD / SESSION_SECRET). The worker uses
# these to fill the records-admin login form on the internal network.
RECORDS_ADMIN_USER=
RECORDS_ADMIN_PASSWORD=
RECORDS_ADMIN_SESSION_SECRET=

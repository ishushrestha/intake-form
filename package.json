{
  "name": "intake-form",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @intake/contracts build && pnpm --parallel --filter @intake/contracts --filter @intake/api --filter @intake/web dev",
    "typecheck": "pnpm -r --sequential typecheck",
    "lint": "eslint .",
    "test": "pnpm -r --sequential test",
    "build": "pnpm -r --sequential build",
    "check-version": "node scripts/check-version.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}

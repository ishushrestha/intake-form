# Intake API on this PC. WORKER_TOKEN in the intake .env must match INTAKE_WORKER_TOKEN.
INTAKE_API_URL=http://127.0.0.1:3001
INTAKE_WORKER_TOKEN=

# records-admin web UI. The worker only opens these pages in a browser.
RECORDS_ADMIN_URL=http://localhost:5174
RECORDS_ADMIN_USER=admin
RECORDS_ADMIN_PASSWORD=change-me

# Set to true to show the Playwright window while it types.
# HEADED=true

# Local Ollama. This must be a loopback address. The worker refuses anything else.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Seconds to wait when no job is queued.
POLL_SECONDS=5

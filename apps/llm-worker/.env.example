# Intake API. Local pnpm worker keeps this URL. Docker Compose sets http://intake:3001.
INTAKE_API_URL=http://127.0.0.1:3001
INTAKE_WORKER_TOKEN=

# Optional. Caddy basic_auth in front of the intake https URL. Sent as Authorization
# on fetch; the worker token is then sent as X-Worker-Authorization.
# INTAKE_BASIC_AUTH_USER=
# INTAKE_BASIC_AUTH_PASS=

# records-admin web UI. The worker only opens these pages in a browser.
# Local pnpm worker keeps this URL. Docker Compose sets http://records-admin:3002.
RECORDS_ADMIN_URL=http://localhost:5174
RECORDS_ADMIN_USER=admin
RECORDS_ADMIN_PASSWORD=change-me

# Optional. Caddy basic_auth in front of the records-admin https URL.
# Used as Playwright httpCredentials.
# RECORDS_ADMIN_BASIC_AUTH_USER=
# RECORDS_ADMIN_BASIC_AUTH_PASS=

# Set to true to show the Playwright window while it types.
# HEADED=true

# Local Ollama. This must be a loopback address (or the Docker service name ollama).
# Local pnpm worker keeps 127.0.0.1. Docker Compose sets http://ollama:11434 for you.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Seconds to wait when no job is queued.
POLL_SECONDS=5
